{
  "name": "mochi-notes",
  "version": "0.1.0",
  "description": "Sticky note + trợ lý ảo bé Mochi nhắc lịch",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64",
    "test": "node scripts/test-all.js",
    "test:e2e": "bash test/e2e/run.sh",
    "test:unit": "node test/unit/run.js",
    "test:persona": "node --test src/main/persona/test/dialogue.test.js src/main/persona/test/lunar.test.js src/main/persona/test/persona.test.js"
  },
  "keywords": [],
  "author": "Joiha",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.48.2"
  },
  "productName": "Mochi Notes",
  "build": {
    "appId": "vn.joiha.mochinotes",
    "productName": "Mochi Notes",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!src/**/test/**",
      "!src/**/tools/**",
      "!src/**/__tests__/**",
      "!**/__tests__/**",
      "!tools/**",
      "!scripts/**",
      "!art/**",
      "!docs/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "asar": true,
    "electronLanguages": [
      "vi",
      "en-US"
    ]
  }
}
